        "order": 9,
        "width": 4,
        "height": 5,
        "format": "<div style=\"background:#050505; padding:20px; border-radius:15px; border:1px solid #ff0055; height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; overflow:hidden;\">\n    <div style=\"color:#ff0055; font-family:monospace; font-size:10px; letter-spacing:2px; margin-bottom:20px;\">VASCULAR TENSION INDEX</div>\n\n    <div style=\"display:flex; gap:8px; height:120px; transform:perspective(500px) rotateX(20deg);\">\n        <div ng-repeat=\"i in [1,2,3,4,5]\" \n             style=\"width:12px; height:100%; background:{{ (msg.payload.temp > 32 && msg.payload.soil < 30) ? '#ff0055' : '#00d4ff' }};\n                    border-radius:6px; box-shadow:0 0 15px currentColor;\n                    opacity:{{0.3 + ($index/7)}};\n                    animation: {{ (msg.payload.temp > 32) ? 'jitter 0.1s infinite' : 'none' }};\">\n            \n            <div style=\"width:100%; height:20%; background:rgba(255,255,255,0.5); \n                        animation: flowUp {{ (msg.payload.pump == 1) ? '0.5s' : '2s' }} linear infinite;\"></div>\n        </div>\n    </div>\n\n    <style>\n        @keyframes jitter { 0% { transform:translateX(0); } 50% { transform:translateX(2px); } 100% { transform:translateX(0); } }\n        @keyframes flowUp { from { transform:translateY(500%); } to { transform:translateY(-100%); } }\n    </style>\n\n    <div style=\"margin-top:20px; font-family:monospace; font-size:14px; color:white;\">\n        TENSION: {{ (msg.payload.temp/msg.payload.soil).toFixed(2) }} <span style=\"font-size:9px; color:#666;\">PSI_EQUIV</span>\n    </div>\n</div>",
