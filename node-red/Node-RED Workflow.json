        "name": "ThingSpeak Formatting",
        "func": "let d = msg.payload;\n\n// Using a clean string join to avoid any \"Template Literal\" errors\nlet baseURL = \"https://api.thingspeak.com/update?api_key=7WNCBDDVLZ8MKUO4\";\nlet params = \"&field1=\" + d.soil +\n             \"&field2=\" + d.temp +\n             \"&field3=\" + d.humidity +\n             \"&field4=\" + d.wind +\n             \"&field5=\" + d.pump +\n             \"&field6=\" + d.alert +\n             \"&field7=\" + d.soilCondition +\n             \"&field8=\" + d.heatStress;\n\n// Set the URL for the next node\nmsg.url = baseURL + params;\nmsg.method = \"GET\";\n\nreturn msg;",
