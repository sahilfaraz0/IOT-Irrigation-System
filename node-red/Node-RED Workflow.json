        "name": "Wind Guage",
        "order": 4,
        "width": 5,
        "height": 4,
        "format": "<div style=\"background: #1a1a1a; padding: 20px; border-radius: 15px; text-align: center; border: 1px solid #333;\">\n    <div style=\"color: #888; font-size: 11px; font-weight: bold; margin-bottom: 15px;\">WIND INTENSITY</div>\n    \n    <div style=\"margin: 20px 0;\">\n        <i class=\"fa fa-snowflake-o\" \n           style=\"font-size: 60px; color: #00d4ff; \n                  animation: spin {{msg.payload.wind > 0 ? (20 / msg.payload.wind) : 0}}s linear infinite;\n                  display: {{msg.payload.wind > 0 ? 'inline-block' : 'none'}};\"></i>\n        <i class=\"fa fa-snowflake-o\" \n           style=\"font-size: 60px; color: #444; display: {{msg.payload.wind > 0 ? 'none' : 'inline-block'}};\"></i>\n    </div>\n\n    <div style=\"font-size: 28px; font-weight: bold; color: white;\">\n        {{msg.payload.wind}}<span style=\"font-size: 14px; color: #888;\"> km/h</span>\n    </div>\n</div>\n\n<style>\n    @keyframes spin { 100% { transform: rotate(360deg); } }\n</style>",
