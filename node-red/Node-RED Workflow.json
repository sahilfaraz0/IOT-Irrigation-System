    {
        "id": "a2bc78862b4e3674",
        "type": "function",
        "z": "88b90a5449b9dbeb",
        "name": "Design Logic",
        "func": "let data = msg.payload;\n\n// 1. Round sensor values and ensure they are Numbers\nlet soil = parseFloat(data.soil.toFixed(2));\nlet temp = parseFloat(data.temp.toFixed(2));\nlet humidity = parseFloat(data.humidity.toFixed(2));\nlet wind = parseFloat(data.wind.toFixed(2));\n\n// 2. Automation Logic (0 or 1)\nlet pump = soil < 30 ? 1 : 0;\nlet alert = soil < 25 ? 1 : 0;\n\n// 3. Categorical Logic (0-3 scale to match your CSV)\nlet soilCondition = 2; // Default: Normal\nif (soil > 80) soilCondition = 3;      // Saturated\nelse if (soil < 30) soilCondition = 1; // Low\nelse if (soil < 20) soilCondition = 0; // Critical\n\nlet heatStress = 1; // Default: Optimal\nif (temp > 30) heatStress = 2;         // Heat Stress Risk\nelse if (temp < 15) heatStress = 0;    // Cool\n\n// 4. Final Payload using Real Time\nmsg.payload = { \n    soil, \n    temp, \n    humidity, \n    wind, \n    pump, \n    alert, \n    soilCondition, \n    heatStress,\n    created_at: new Date().toISOString() // Real current time\n};\n\nreturn [msg, msg];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
