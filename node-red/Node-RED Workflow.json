    {
        "id": "5575f76b72576c4e",
        "type": "function",
        "z": "88b90a5449b9dbeb",
        "name": "Fetch Data from MQTT",
        "func": "let prev = context.get(\"soil\") || 45;\n\nlet soil = prev - Math.random() * 1.5;\nif (soil < 25) {\n    soil = 45 + Math.random() * 5;\n}\ncontext.set(\"soil\", soil);\n\nlet temp = 25 + Math.random() * 10;\nlet humidity = 80 - (temp - 25) * 2 + Math.random() * 5;\nlet wind = Math.random() * 10;\n\nmsg.payload = { soil, temp, humidity, wind };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 340,
        "wires": [
