        "type": "ui_template",
        "z": "88b90a5449b9dbeb",
        "group": "5967add91971af25",
        "name": "Thermal Velocity Sphere",
        "order": 5,
        "width": 4,
        "height": 6,
        "format": "<div style=\"height:300px; background:#050505; border-radius:15px; border:1px solid #ff4500; display:flex; flex-direction:column; align-items:center; justify-content:center; overflow:hidden;\">\n    <div id=\"sphere_container_{{$id}}\" style=\"width:150px; height:150px; border-radius:50%; border:2px solid #222; position:relative; display:flex; align-items:center; justify-content:center; transition: all 1s;\">\n        <div id=\"core_{{$id}}\" style=\"width:60px; height:60px; border-radius:50%; background:#ff4500; box-shadow: 0 0 40px #ff4500; transition: all 1s;\"></div>\n        \n        <div id=\"orbit_{{$id}}\" style=\"position:absolute; width:100%; height:100%; border:1px dashed #444; border-radius:50%; animation: spin 3s linear infinite;\"></div>\n    </div>\n    <div id=\"label_{{$id}}\" style=\"margin-top:20px; font-family:monospace; color:#fff; font-size:12px;\">THERMAL LOAD: NOMINAL</div>\n</div>\n\n<script>\n(function(scope) {\n    scope.$watch('msg', function(msg) {\n        if (!msg) return;\n        const temp = msg.payload.field2 || 25;\n        const wind = msg.payload.field4 || 0;\n        \n        const core = document.getElementById('core_' + scope.$id);\n        const orbit = document.getElementById('orbit_' + scope.$id);\n        const label = document.getElementById('label_' + scope.$id);\n        \n        // Manipulate color based on Temp\n        const hue = 200 - (temp * 4); // Shifts from Blue to Red\n        if(core) {\n            core.style.background = 'hsl(' + hue + ', 100%, 50%)';\n            core.style.boxShadow = '0 0 40px hsl(' + hue + ', 100%, 50%)';\n        }\n        \n        // Manipulate spin based on Wind\n        if(orbit) {\n            const speed = wind > 0 ? (20 / wind) : 0;\n            orbit.style.animationDuration = speed + 's';\n        }\n    });\n})(scope);\n</script>\n\n<style> @keyframes spin { to { transform: rotate(360deg); } } </style>",
