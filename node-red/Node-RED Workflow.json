    {
        "id": "af1cd5361d9906b3",
        "type": "function",
        "z": "88b90a5449b9dbeb",
        "name": "Visual Logic",
        "func": "let d = msg.payload;\n\n// 1. Calculate Statuses and Colors\n// Healthy = Green, Warning = Orange, Critical = Red\n\n// Metric 1: Soil Moisture\nlet soilStatus = 'Good';\nlet soilColor = '#4CAF50'; // Green\nif (d.soil < 30) { \n    soilStatus = 'Dry'; \n    soilColor = '#FF9800'; // Orange\n}\nif (d.soil < 20) { \n    soilStatus = 'Critical'; \n    soilColor = '#F44336'; // Red\n}\n\n// Metric 2: Irrigation Pump\nlet pumpStatus = 'Idle';\nlet pumpColor = '#9E9E9E'; // Gray\nif (d.pump === 1) { \n    pumpStatus = 'ACTIVE'; \n    pumpColor = '#2196F3'; // Blue\n}\n\n// Metric 3: System Alerts\nlet alertStatus = 'All Nominal';\nlet alertColor = '#4CAF50'; // Green\nif (d.alert === 1) { \n    alertStatus = 'LOW MOISTURE ALERT'; \n    alertColor = '#F44336'; // Red\n}\n\n// Metric 4: Climate (Simplistic)\nlet climateStatus = 'Optimal';\nlet climateColor = '#4CAF50'; // Green\nif (d.temp > 30 || d.humidity < 30) {\n    climateStatus = 'Warning: Dry/Hot';\n    climateColor = '#FF9800'; // Orange\n}\n\n// 2. Prepare the final Payload for the UI Template\nmsg.payload = {\n    soil: { status: soilStatus, color: soilColor },\n    pump: { status: pumpStatus, color: pumpColor },\n    alert: { status: alertStatus, color: alertColor },\n    climate: { status: climateStatus, color: climateColor }\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 300,
        "wires": [
            [
                "d0d749cad79cca9c"
            ]
        ]
    },
    {
        "id": "d0d749cad79cca9c",
        "type": "ui_template",
        "z": "88b90a5449b9dbeb",
        "group": "02d921f2398b7aef",
        "name": "Indicator Grid",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<style>\n    /* 1. Global styling and Font-Awesome support */\n    @import url('https://maxcdn.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css');\n    \n    /* 2. Create the Grid Layout (Forces 4 columns) */\n    .farm-grid {\n        display: grid;\n        grid-template-columns: repeat(4, 1fr);\n        gap: 15px;\n        width: 100%;\n        padding: 10px;\n    }\n\n    /* 3. Base style for each status card */\n    .farm-card {\n        background: #1e1e1e;\n        border-radius: 8px;\n        padding: 20px;\n        text-align: center;\n        border: 1px solid #333;\n        transition: all 0.3s ease;\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        justify-content: center;\n    }\n\n    /* 4. Active state effect (A subtle glow from the bottom) */\n    .farm-card.active {\n        box-shadow: 0 4px 15px rgba(255, 255, 255, 0.1);\n        border-color: #555;\n    }\n\n    /* 5. Typography */\n    .card-title {\n        color: #888;\n        font-size: 11px;\n        text-transform: uppercase;\n        letter-spacing: 1px;\n        margin-bottom: 10px;\n    }\n    .card-status {\n        font-weight: bold;\n        font-size: 16px;\n        margin-top: 5px;\n    }\n</style>\n\n<div class=\"farm-grid\">\n    <div class=\"farm-card active\">\n        <div class=\"card-title\">SOIL CONDITION</div>\n        <i class=\"fa fa-tint fa-2x\" style=\"color: {{msg.payload.soil.color}};\"></i>\n        <div class=\"card-status\" style=\"color: {{msg.payload.soil.color}};\">{{msg.payload.soil.status}}</div>\n    </div>\n\n    <div class=\"farm-card active\">\n        <div class=\"card-title\">IRRIGATION PUMP</div>\n        <i class=\"fa fa-cogs fa-2x {{msg.payload.pump.status === 'ACTIVE' ? 'fa-spin' : ''}}\" style=\"color: {{msg.payload.pump.color}};\"></i>\n        <div class=\"card-status\" style=\"color: {{msg.payload.pump.color}};\">{{msg.payload.pump.status}}</div>\n    </div>\n\n    <div class=\"farm-card active\">\n        <div class=\"card-title\">SYSTEM SAFETY</div>\n        <i class=\"fa fa-shield fa-2x\" style=\"color: {{msg.payload.alert.color}};\"></i>\n        <div class=\"card-status\" style=\"color: {{msg.payload.alert.color}};\">{{msg.payload.alert.status}}</div>\n    </div>\n\n    <div class=\"farm-card active\">\n        <div class=\"card-title\">FARM CLIMATE</div>\n        <i class=\"fa fa-cloud fa-2x\" style=\"color: {{msg.payload.climate.color}};\"></i>\n        <div class=\"card-status\" style=\"color: {{msg.payload.climate.color}};\">{{msg.payload.climate.status}}</div>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 940,
        "y": 300,
        "wires": [
            []
        ]
    },
    {
        "id": "8d9a84bde52fedb9",
        "type": "ui_template",
